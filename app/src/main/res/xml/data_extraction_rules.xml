<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the vault out of cloud backups and device-to-device transfers -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault" />
        <exclude domain="file" path="vault.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault" />
        <exclude domain="file" path="vault.json" />
    </device-transfer>
</data-extraction-rules>
